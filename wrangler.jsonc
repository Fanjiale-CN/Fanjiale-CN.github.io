// Root shim for Cloudflare Git integration. The canonical Radar Worker source stays under workers/radar/.
{
  "name": "galok-radar",
  "main": "workers/radar/src/index.js",
  "compatibility_date": "2026-08-26",
  "routes": [
    {
      "pattern": "www.galok.me/api/signals/*",
      "zone_name": "galok.me"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RADAR_BUCKET",
      "bucket_name": "galok-media"
    }
  ]
}
