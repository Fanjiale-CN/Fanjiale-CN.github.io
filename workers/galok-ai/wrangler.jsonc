{
  "name": "galok-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "routes": [
    {
      "pattern": "www.galok.me/api/ask*",
      "zone_name": "galok.me"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_BUDGET",
        "class_name": "AiBudgetGate"
      }
    ]
  },
  "exports": {
    "AiBudgetGate": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
